                "conditions": [
                  {
                    "id": "cond-word",
                    "leftValue": "={{ $binary.document.mimeType }}",
                    "rightValue": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                    "operator": { "type": "string", "operation": "equals", "name": "filter.operator.equals" }
