      "id": "b8928682-24bc-4cea-a9c7-fa8335eb47e5",
      "name": "🔀 Switch – Type de fichier",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [-640, 320]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item;\nconst binaryData = item.binary || {};\n\nif (binaryData.document && binaryData.document.data) {\n  return [item];\n}\n\nconst altNames = ['data', 'file', 'upload', 'attachment', 'pdf', 'binary'];\nfor (const name of altNames) {\n  if (binaryData[name]) {\n    const newBinary = { document: { ...binaryData[name] } };\n    if (!newBinary.document.mimeType) newBinary.document.mimeType = 'application/pdf';\n    return [{ json: item.json, binary: newBinary }];\n  }\n}\n\nconst jsonData = item.json || {};\nconst base64Fields = ['document', 'file', 'data', 'pdf', 'content', 'fileData'];\nfor (const field of base64Fields) {\n  if (jsonData[field] && typeof jsonData[field] === 'string') {\n    let b64 = jsonData[field];\n    if (b64.includes(',')) b64 = b64.split(',')[1];\n    const buffer = Buffer.from(b64, 'base64');\n    const binaryDoc = await this.helpers.prepareBinaryData(buffer, jsonData.fileName || 'document.pdf', 'application/pdf');\n    return [{ json: item.json, binary: { document: binaryDoc } }];\n  }\n}\n\nthrow new Error('Aucune donnée PDF trouvée.');"
      },
