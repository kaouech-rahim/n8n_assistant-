# ── n8n ──────────────────────────────────────────────────────────────────────
# URL de base du serveur n8n
N8N_URL=http://localhost:5678

# Base URL des webhooks n8n (utilisée par le backend pour appeler n8n)
N8N_WEBHOOK_BASE=http://localhost:5678/webhook

# ── App ───────────────────────────────────────────────────────────────────────
# Port du serveur Express (défaut : 3001)
PORT=3001

# En production Docker, la DB est dans /app/data/app.db (volume persistant)
# DB_PATH=/app/data/app.db

# ── Dev only (Vite) ───────────────────────────────────────────────────────────
# Laisser vide en production : le frontend utilise /api (relatif au même serveur)
# VITE_API_URL=http://localhost:3001
